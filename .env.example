# Padakan settings. Copy to <repo>-padakan/.env (per project) or to the plugin .env (machine-wide).
# Load order, first value wins: exported environment, then <records>/.env, then the plugin .env, then the default shown here.
# Never put values in this file; it is committed.

# ── General ─────────────────────────────────────────────────────
# Language of briefs, reports and specs.
PADAKAN_LANGUAGE=en
# Name of the records folder next to the repo; {repo} is replaced by the repo folder name.
PADAKAN_RECORDS_NAME={repo}-padakan
# Absolute path of the records folder; overrides PADAKAN_RECORDS_NAME.
PADAKAN_RECORDS_DIR=
# Where tasks are filed. One of: linear, github, none.
PADAKAN_TRACKER=linear
# Linear API key. Orchestrator only; trees never get it. Secret.
LINEAR_API_KEY=

# ── Terminal and driver ─────────────────────────────────────────
# Terminal for the orchestrator and for non-Devin trees. One of: herdr, none.
PADAKAN_TERMINAL=herdr
# How a non-Devin tree agent is driven: herdr, or headless for CI. One of: herdr, headless.
PADAKAN_DRIVER=herdr
# Prefix of herdr workspace names.
HERDR_SESSION_PREFIX=padakan

# ── Sandboxes ───────────────────────────────────────────────────
# Where trees run. One of: devin, daytona, local.
PADAKAN_SANDBOX_PROVIDER=devin
# Trees running at once.
PADAKAN_MAX_TREES=3
# Daytona API key. Secret.
DAYTONA_API_KEY=
# Daytona API base URL.
DAYTONA_API_URL=https://app.daytona.io/api
# Daytona region. One of: eu, us.
DAYTONA_TARGET=eu
# Snapshot baked from sandboxes/daytona/snapshot/.
DAYTONA_SNAPSHOT=padakan-base
# vCPU per sandbox, fixed at bake time.
DAYTONA_CPU=2
# GB of memory per sandbox, fixed at bake time.
DAYTONA_MEMORY=4
# GB of disk per sandbox, fixed at bake time.
DAYTONA_DISK=10
# Idle minutes before a sandbox stops.
DAYTONA_AUTO_STOP=15
# Minutes after stopping before a sandbox is deleted.
DAYTONA_AUTO_DELETE=1440

# ── Agents and models ───────────────────────────────────────────
# Agent inside a non-Devin tree. One of: claude, devin, openai-compat.
PADAKAN_HARNESS=claude
# Model the tree agent runs.
PADAKAN_TREE_MODEL=claude-sonnet-5-5
# Tree login from `claude setup-token`. Secret.
CLAUDE_CODE_OAUTH_TOKEN=
# Second account, used when the first is rate-limited. Secret.
CLAUDE_CODE_OAUTH_FALLBACK_TOKEN=
# Nebius Token Factory API key. Secret.
NEBIUS_API_KEY=
# Nebius Token Factory base URL (OpenAI-compatible).
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Model that triages monitor clusters.
PADAKAN_TRIAGE_MODEL=nvidia/nemotron-3-super-120b-a12b
# Model that writes capability manifests.
PADAKAN_RESOLVER_MODEL=nvidia/nemotron-3-super-120b-a12b
# Model for the openai-compat harness.
PADAKAN_BUILDER_MODEL=
# Devin API base URL.
DEVIN_API_URL=https://api.devin.ai/v3
# Devin service-user token (cog_…), needs UseDevinSessions. Secret.
DEVIN_API_KEY=
# Devin organization id (org-…).
DEVIN_ORG_ID=
# Hard ceiling for any session's max_acu_limit; the cost gate sets the actual value.
DEVIN_MAX_ACU=
# linux, macos, windows, or an Outpost pool name; the resolver can override per task.
DEVIN_PLATFORM=linux
# Optional devin_mode (normal, fast, lite, ultra, fusion); empty uses the org default; affects cost.
DEVIN_MODE=
# No approval prompts inside sessions.
DEVIN_BYPASS_APPROVAL=true
# Optional playbook with Padakan's standing instructions.
DEVIN_PLAYBOOK_ID=
# How often a session is polled.
DEVIN_POLL_SECONDS=30
# Smallest raise worth a continuation session (raiseBudget).
DEVIN_CONTINUATION_MIN_ACU=2

# ── Git ─────────────────────────────────────────────────────────
# GitHub token for trees: host (gh auth token) or pat (GH_PAT). One of: host, pat.
GH_TOKEN_SOURCE=host
# Fine-grained token: Contents RW, Pull requests RW, Metadata R. Secret.
GH_PAT=
# Commit identity for trees. Required.
GIT_AUTHOR_NAME=
# Commit email for trees (registered on GitHub). Required.
GIT_AUTHOR_EMAIL=

# ── Context ─────────────────────────────────────────────────────
# Use Entire: session capture and the local code graph.
ENTIRE_ENABLED=false
# on once the human connects the repo to Entire at the plan gate. One of: on, off.
ENTIRE_SEARCH=off
# owner/repo as published on Entire.
ENTIRE_REPO=

# ── Gates ───────────────────────────────────────────────────────
# Paths diff inspection refuses (comma-separated globs).
PADAKAN_PROTECTED_PATHS=.github/,infra/,**/*.lock
# Most lines a change may touch.
PADAKAN_MAX_DIFF_LINES=60
# Most files a change may touch.
PADAKAN_MAX_DIFF_FILES=3

# ── Cost ────────────────────────────────────────────────────────
# Budget cap per run; empty means no cap.
PADAKAN_BUDGET_RUN_USD=
# Budget cap per task; empty means no cap.
PADAKAN_BUDGET_TASK_USD=
# Budget cap per step; empty means no cap.
PADAKAN_BUDGET_STEP_USD=
# The team's real Devin ACU price. Required with the devin provider; the gate pauses rather than guess. Required in some setups (see description).
PADAKAN_DEVIN_USD_PER_ACU=

# ── Monitor ─────────────────────────────────────────────────────
# Minutes between monitor ticks.
PADAKAN_WATCH_INTERVAL_MIN=15
# Log sources: docker, file paths or URLs (comma-separated).
PADAKAN_LOG_SOURCES=docker

# ── Deploy ──────────────────────────────────────────────────────
# Where gated deploys go. One of: simulated, railway, vercel.
PADAKAN_DEPLOY_TARGET=simulated
# Share of traffic on the canary.
PADAKAN_CANARY_PERCENT=10
# Error rate that triggers rollback during the canary.
PADAKAN_SLO_ERROR_RATE=0.01
